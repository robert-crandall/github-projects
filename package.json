{
  "name": "github-projects",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build",
    "dev:desktop": "vite --config vite.desktop.config.ts --host 127.0.0.1",
    "build:desktop": "tsc --noEmit && vite build --config vite.desktop.config.ts",
    "build:service": "bun scripts/package-service.ts",
    "tauri": "tauri",
    "native:dev": "tauri dev",
    "native:build": "tauri build --bundles app",
    "install_app": "bun run native:build && rsync -a --delete \"src-tauri/target/release/bundle/macos/GitHub Projects.app/\" \"/Applications/GitHub Projects.app/\"",
    "test:native": "cargo test --manifest-path src-tauri/Cargo.toml",
    "test": "bun test src",
    "themes:import": "bun scripts/import-themes.ts",
    "test:browser": "playwright test"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.10.1",
    "@js-temporal/polyfill": "^0.5.1",
    "lucide-react": "^0.468.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "zod": "^4.1.5"
  },
  "devDependencies": {
    "@basiclines/rampa-sdk": "5.0.0",
    "@primer/primitives": "11.10.0",
    "@tauri-apps/cli": "^2.10.1",
    "@playwright/test": "^1.55.0",
    "@types/bun": "^1.2.21",
    "@types/react": "^19.1.13",
    "@types/react-dom": "^19.1.9",
    "@vitejs/plugin-react": "^5.0.2",
    "typescript": "^5.9.2",
    "vite": "^7.1.5"
  }
}
